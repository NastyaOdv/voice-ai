# Copy to .env and set the API key.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
LLM_QUEUE=llm.rpc

# Anthropic model. claude-opus-5 is the strongest; claude-haiku-4-5 / claude-sonnet-5
# are much cheaper for high-frequency turns.
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=1024

# The Anthropic SDK reads this automatically.
ANTHROPIC_API_KEY=
