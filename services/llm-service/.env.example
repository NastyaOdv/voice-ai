# Copy to .env and set the LiteLLM virtual key.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
LLM_QUEUE=llm.rpc

# LiteLLM public model name (alias), NOT a provider model id. Map it to an actual model
# in the LiteLLM UI (http://localhost:4000/ui) — switching model or provider is a config
# change there, not a code change here. Point the alias at a cheap model for high-frequency
# turns.
LLM_MODEL=tutor-default
LLM_MAX_TOKENS=1024

# LiteLLM proxy (LLM gateway): llm-service only ever talks to the proxy.
# LLM_API_KEY is a LiteLLM *virtual key* (sk-...). Provider API keys do NOT belong here —
# they are stored inside LiteLLM.
LLM_BASE_URL=http://localhost:4000
LLM_API_KEY=
