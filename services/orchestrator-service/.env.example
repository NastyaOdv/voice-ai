# Copy to .env and adjust.

# Environment: "dev" enables docs at /docs; "prod" disables docs.
ENV=dev

# Database (DB_ prefix)
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=orchestrator_service
DB_HOST=localhost
DB_PORT=5434
DB_SSLMODE=disable

# Redis (hot session context cache)
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600

# RabbitMQ (service-to-service RPC)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Local audio storage
STORAGE_DIR=storage/audio

# Session history window sent to the LLM, cut in steps: once the history passes
# MAX_PAIRS it is cut back to KEEP_PAIRS, then left to grow again. Stepping keeps the
# payload's first message in place between steps so prompt caching keeps working — a
# window sliding one pair per turn moves it every call and measured 0% cache reads.
# The full session stays in Redis/Postgres; this only bounds the request payload.
# MAX_PAIRS=0 disables trimming (sends the whole session).
# NOTE: the orchestrator runs from docker-compose, which passes its environment
# explicitly — change these in docker-compose.yml, not only here.
LLM_HISTORY_MAX_PAIRS=40
LLM_HISTORY_KEEP_PAIRS=25

# JWT validation against auth-service: paste auth's RS256 public key (public.pem).
# Newlines may be real or escaped "\n" (both accepted).
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
