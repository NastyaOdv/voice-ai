# Copy to .env and adjust.

# Environment: "dev" enables docs at /docs; "prod" disables docs.
ENV=dev

# Database (DB_ prefix)
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=orchestrator_service
DB_HOST=localhost
DB_PORT=5434
DB_SSLMODE=disable

# Redis (hot session context cache)
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600

# RabbitMQ (service-to-service RPC)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Local audio storage
STORAGE_DIR=storage/audio

# JWT validation against auth-service
AUTH_PUBLIC_KEY_URL=http://localhost:8001/auth/public-key
JWT_ALGORITHM=RS256
