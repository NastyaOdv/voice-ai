# Copy to .env and adjust.

# Environment: "dev" enables docs at /docs; "prod" disables docs.
ENV=dev

# Database (DB_ prefix)
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=user_service
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable

# JWT validation against auth-service: paste auth's RS256 public key (public.pem).
# Newlines may be real or escaped "\n" (both accepted).
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
