# Copy to .env and fill in the Google credentials.

# Environment: "dev" enables docs at /docs; "prod" disables docs.
ENV=dev

# Database (DB_ prefix)
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=auth_service
DB_HOST=localhost
DB_PORT=5433
DB_SSLMODE=disable

# RS256 JWT. Generate a key pair once with openssl:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste private.pem here as JWT_PRIVATE_KEY and public.pem into the other services as
# JWT_PUBLIC_KEY. Newlines may be real or escaped "\n" (both accepted).
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback
