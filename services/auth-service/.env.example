# Copy to .env and fill in the Google credentials.

# Environment: "dev" enables docs at /docs; "prod" disables docs.
ENV=dev

# Database (DB_ prefix)
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=auth_service
DB_HOST=localhost
DB_PORT=5433
DB_SSLMODE=disable

# RS256 JWT (keys are generated into ./keys on first container start)
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback
